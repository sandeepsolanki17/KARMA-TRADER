enable-pre-post-scripts=true

# Expo's own guidance for pnpm monorepos: hoist React (and RN's core) to a
# single shared copy at the workspace root. Without this, strict pnpm
# isolation lets different apps in the monorepo end up with their own
# nested React copies, and Metro/Expo's SSR export can pick up the wrong
# one mid-bundle ("Cannot read properties of null (reading 'useEffect')").
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*@expo*
