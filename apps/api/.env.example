# Server
NODE_ENV=<REQUIRED>
PORT=<REQUIRED>
LOG_LEVEL=<REQUIRED>
CORS_ORIGIN=<REQUIRED>

# Postgres
DATABASE_URL=<REQUIRED>

# Redis / BullMQ
REDIS_URL=<REQUIRED>

# Clerk (https://dashboard.clerk.com)
