CLERK_PUBLISHABLE_KEY=<REQUIRED>
CLERK_AUTHORIZED_PARTIES=<REQUIRED>
CLERK_WEBHOOK_SECRET=<REQUIRED>

# Expo push
EXPO_ACCESS_TOKEN=<REQUIRED>

# Angel One SmartAPI (broker integration — see docs/angel-one.md)
ANGEL_ONE_API_KEY=<REQUIRED>
ANGEL_ONE_CLIENT_CODE=<REQUIRED>
ANGEL_ONE_PUBLISHER_APP_ID=<REQUIRED>

