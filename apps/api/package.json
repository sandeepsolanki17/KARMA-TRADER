{
  "name": "@karma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:test": "DOTENV_CONFIG_PATH=.env.test tsx -r dotenv/config src/db/migrate.ts",
    "test": "NODE_ENV=test dotenv -e .env.test -- vitest run",
    "test:watch": "NODE_ENV=test dotenv -e .env.test -- vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.15.5",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@karma/types": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "bullmq": "^5.13.2",
    "close-with-grace": "^2.2.0",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.11.0",
    "fastify": "^4.28.1",
    "fastify-raw-body": "^4.3.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "svix": "^1.36.0",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "tsx": "^4.19.0",
    "vitest": "^2.0.5"
  }
}
