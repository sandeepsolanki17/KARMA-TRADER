# This file tells EAS Build what to exclude when archiving from the monorepo root.
# EAS will include everything NOT listed here.

# Ignore node_modules everywhere (EAS installs them fresh on build servers)
**/node_modules

# Ignore other app outputs
apps/api/dist
apps/admin/dist

# Ignore OS and editor files
.DS_Store
Thumbs.db
.idea
.vscode

# Ignore local env files (env vars are injected via eas.json "env" block)
**/.env
**/.env.local
**/.env.*.local
